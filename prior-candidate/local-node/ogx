#!/usr/bin/env bash
set -euo pipefail
ROOT="${OGX_HOME:-$HOME/.local/share/ogx}"
STATE="${OGX_STATE_HOME:-$HOME/.local/state/ogx}"
case "${1:-status}" in
 status) echo "OGX_LOCAL_NODE=INSTALLED"; echo "ROOT=$ROOT"; echo "STATE=$STATE"; echo "EFFECT_CEILING=E0_LOCAL_ONLY";;
 doctor) test -d "$ROOT/releases" && test -d "$STATE" && echo "OGX_DOCTOR=PASS";;
 fleet) find "$ROOT/releases" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort;;
 *) echo "usage: ogx {status|doctor|fleet}" >&2; exit 2;;
esac

